{
  "name": "fantasy-motogp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fantasy MotoGP Independiente — monolito modular (Next.js + Prisma + tRPC).",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:purity && next build",
    "start": "next start",
    "check:purity": "tsx scripts/check-purity/cli.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.full.config.ts --coverage",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:load": "echo \"(carga pendiente)\" && exit 0",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "seed:fiction": "tsx scripts/seed/fiction-local.ts",
    "fetch:data": "tsx scripts/simulate/fetch.ts",
    "simulate": "tsx scripts/simulate/simulate.ts",
    "calibrate": "tsx scripts/simulate/calibrate.ts",
    "simulate:fiction": "tsx scripts/simulate/fiction.ts",
    "simulate:viz": "tsx scripts/simulate/viz.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.7.0",
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "superjson": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.4.0",
    "prisma": "^6.7.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "cpu-features@0.0.10": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.19.3": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true
  }
}
