# Producción — TrueNAS Scale (T-19, WP4).
# Copiar a .env (misma carpeta que deploy.sh) y rellena los <...>.
# NUNCA commitear el .env real. Después: chmod 600 .env
# Paso a paso: docs/operations/deploy.md §1.4.

# ── PostgreSQL (el contenedor crea el usuario/BD en el primer arranque) ────
POSTGRES_USER="motogp"
POSTGRES_DB="motogp"
# Generar con: openssl rand -hex 32
POSTGRES_PASSWORD="<openssl-rand-hex-32>"

# ── App (valores DENTRO de la red Docker: el host es el nombre del servicio) ─
# Debe coincidir con POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB de arriba.
DATABASE_URL="postgresql://motogp:<POSTGRES_PASSWORD>@postgres:5432/motogp?schema=public"
REDIS_URL="redis://redis:6379"
# Generar con: openssl rand -hex 32 (un valor DIFERENTE del de arriba).
SESSION_SECRET="<openssl-rand-hex-32>"
# Bootstrap de global_admin (T-08, ADR-0010): el PRIMER registro con este
# email (minúsculas) recibe el rol `global_admin`. Vacía → nadie lo recibe.
BOOTSTRAP_ADMIN_EMAIL=""
# US-31: UUID de una liga pública, visible y activa; vacío = bienvenida desactivada.
WELCOME_LEAGUE_ID=""
# Se "hornea" en el bundle del cliente en el build (deploy.sh lo pasa como --build-arg).
NEXT_PUBLIC_APP_URL="https://motogp.raulmorales.eu"

# ── Host (TrueNAS) ───────────────────────────────────────────────────────────
# Puerto del host que expone la web (Nginx Proxy Manager apunta a 192.168.1.3:22020).
WEB_HOST_PORT="22020"
