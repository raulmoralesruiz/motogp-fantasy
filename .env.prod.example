# Producción — TrueNAS Scale (T-19, WP4).
# Copiar a .env (misma carpeta que deploy.sh) y rellena los <...>.
# NUNCA commitear el .env real. Después: chmod 600 .env
# Paso a paso: docs/operations/deploy.md §1.4.

# ── PostgreSQL (el contenedor crea el usuario/BD en el primer arranque) ────
POSTGRES_USER="motogp"
POSTGRES_DB="motogp"
# Generar con: openssl rand -hex 32
POSTGRES_PASSWORD="<openssl-rand-hex-32>"

# ── App (valores DENTRO de la red Docker: el host es el nombre del servicio) ─
# Debe coincidir con POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB de arriba.
DATABASE_URL="postgresql://motogp:<POSTGRES_PASSWORD>@postgres:5432/motogp?schema=public"
REDIS_URL="redis://redis:6379"
# Generar con: openssl rand -hex 32 (un valor DIFERENTE del de arriba).
SESSION_SECRET="<openssl-rand-hex-32>"
# Bootstrap de global_admin (T-08, ADR-0010): el PRIMER registro con este
# email (minúsculas) recibe el rol `global_admin`. Vacía → nadie lo recibe.
BOOTSTRAP_ADMIN_EMAIL=""
# US-31: UUID de una liga pública, visible y activa; vacío = bienvenida desactivada.
WELCOME_LEAGUE_ID=""
# 2FA TOTP (D-07, ADR-0039): parámetros operativos del segundo factor
# (opt-in; recomendado para global_admin). Defaults: reto 300 s; 5 códigos
# por reto. Para cambiarlos: fijar aquí y redeployar.
#TOTP_CHALLENGE_TTL_SEC="300"
#TOTP_MAX_ATTEMPTS="5"
# Se "hornea" en el bundle del cliente en el build (deploy.sh lo pasa como --build-arg).
NEXT_PUBLIC_APP_URL="https://motogp.raulmorales.eu"
# ── Notificaciones por email (US-36, ADR-0033) ───────────────────────────────
# API key de Resend (https://resend.com → API Keys). SECRETO: nunca en el repo.
# Vacía → las notificaciones se loguean en el servidor (LogNotificationSender):
# `docker logs motogp-web | grep notification` (modo dev/provisional, ADR-0009).
RESEND_API_KEY=""
# Remitente verificado en Resend (Dashboard → Domains → añadir
# motogp.raulmorales.eu, verificar DNS DKIM/SPF, y fijar el remitente a ese
# dominio). En producción: no-reply@motogp.raulmorales.eu (verificado 2026-11-02).
# Con onboarding@resend.dev (plan gratuito) solo se puede enviar al dueño de la
# cuenta (403 al resto); el dominio verificado levanta esa restricción.
# Sin RESEND_API_KEY no se usa.
EMAIL_FROM="Fantasy MotoGP <no-reply@motogp.raulmorales.eu>"

# ── Monitoreo (T-14, ADR-0036) ───────────────────────────────────────────────
# Sentry: DSN del proyecto (self-hosted en TrueNAS — `deploy.md` §8 — o el
# free tier de sentry.io; el código es idéntico, solo cambia la DSN).
# VACÍA = desactivado (los capturers son no-op; alertas de email + panel
# siguen funcionando). Es la clave pública del proyecto (no un secreto).
# Se inlinde en el bundle del cliente EN EL BUILD: fijar/cambiarla ⇒ ./deploy.sh.
#NEXT_PUBLIC_SENTRY_DSN=""
# Destinatario de las alertas operativas (fallo final de job, umbral de
# fallos del auto-import, probe de PulseLive y sus recuperaciones).
# VACÍA = sin canal de email (Sentry + log; el sink nunca lanza).
# Reutiliza el envío de Resend de arriba (RESEND_API_KEY + EMAIL_FROM).
#OPS_ALERT_EMAIL="no-reply@motogp.raulmorales.eu"

# ── Host (TrueNAS) ───────────────────────────────────────────────────────────
# Puerto del host que expone la web (Nginx Proxy Manager apunta a 192.168.1.3:22020).
WEB_HOST_PORT="22020"
