# Copiar a .env y ajustar. NUNCA commitear .env (ver docs/architecture/security.md).

# PostgreSQL local (arrancar con: docker compose up -d)
DATABASE_URL="postgresql://motogp:motogp@localhost:5432/motogp?schema=public"

# Redis local (arrancar con: docker compose up -d)
REDIS_URL="redis://localhost:6379"

# Secreto de sesión (lo usará el módulo identity en Fase 1). Generar con: openssl rand -hex 32
SESSION_SECRET="cambiar-este-seguro"

# URL pública de la app (links, emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
