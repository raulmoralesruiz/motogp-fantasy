# Copiar a .env y ajustar. NUNCA commitear .env (ver docs/architecture/security.md).

# PostgreSQL local (arrancar con: docker compose up -d)
DATABASE_URL="postgresql://motogp:motogp@localhost:5432/motogp?schema=public"

# Redis local (arrancar con: docker compose up -d)
REDIS_URL="redis://localhost:6379"

# Secreto de sesión (reservado: aún no lo consume el código; las sesiones son tokens opacos aleatorios en BD). Generar con: openssl rand -hex 32
SESSION_SECRET="cambiar-este-seguro"

# URL pública de la app (se usa para componer el link de recuperación de contraseña; se pasa como build-arg en CI y al contenedor)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Recuperación de contraseña (US-02)
# Vigencia del token de recuperación (segundos)
RESET_TOKEN_TTL_SEC="3600"
# Máx. solicitudes de recuperación por IP y por ventana (rate limit)
RESET_RATE_LIMIT_MAX="5"
# Ventana del rate limit de recuperación (segundos)
RESET_RATE_LIMIT_WINDOW_SEC="300"

# T-11 (suite E2E): anti-fuerza-bruta de ligas (US-23/US-25). SOLO para
# entornos de prueba locales/CI, donde la suite E2E crea y une varias ligas
# por corrida desde una misma IP (3 viewports en paralelo). En producción NO
# fijar estas variables: se usan los defaults de `app/server/env.ts`
# (creación 5/hora por usuario; unión 10/60 s por IP; bloqueo a los 5 fallos).
# La semántica anti-fuerza-bruta la cubren los tests de integración
# (rate-limit), no la E2E.
#LEAGUE_CREATE_RATE_LIMIT_MAX="50"
#LEAGUE_JOIN_RATE_LIMIT_MAX="50"
#LEAGUE_JOIN_LOCKOUT_THRESHOLD="50"

# T-12/ADR-0035: anti-flood de REGISTRO (anti-fuerza-bruta de cuentas,
# security.md §1.6). SOLO para entornos de prueba locales/CI, donde la suite
# E2E registra ~30 cuentas por corrida desde una misma IP. En producción NO
# fijar esta variable: se usa el default de `app/server/env.ts`
# (10 registros/hora por IP). La semántica la cubren los tests de
# integración (auth.test.ts "T-12/ADR-0035"), no la E2E.
#AUTH_REGISTER_RATE_LIMIT_MAX="100"

# Bootstrap de admin (T-08, ADR-0010): el registro con este email (minúsculas)
# recibe el rol global_admin. Vacío = nadie lo recibe.
# Debe fijarse ANTES del primer registro con ese email (BD nueva).
BOOTSTRAP_ADMIN_EMAIL=""

# Liga de bienvenida (US-31): UUID de una liga pública, visible y activa.
# Vacío = no añadir automáticamente a los nuevos usuarios a ninguna liga.
WELCOME_LEAGUE_ID=""
